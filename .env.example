# Local development only. Production values belong in /etc/cryptosentry.env.
DATABASE_PATH=./data/monitor.sqlite
API_TOKEN=replace-with-a-long-random-token
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
