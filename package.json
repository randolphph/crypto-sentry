{
  "name": "crypto-sentry",
  "version": "0.1.0",
  "private": true,
  "description": "Personal crypto market and on-chain position monitoring service",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:aave:live": "node --env-file-if-exists=.env --import tsx src/cli/aave-smoke.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:shell": "bash -n scripts/*.sh",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm lint:shell && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@aave-dao/aave-address-book": "^4.67.4",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "better-sqlite3": "^12.2.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "viem": "^2.56.5",
    "ws": "^8.21.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
